# Copy to .env and fill in. Used by docker compose (env_file).
# No quotes and no spaces around "=".

# --- MQTT (your local broker) ---
MQTT_HOST=192.168.1.2
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=navimow
MQTT_DISCOVERY=true
MQTT_DISCOVERY_PREFIX=homeassistant

# --- Fallback polling (the cloud normally pushes state over MQTT) ---
HTTP_POLL_INTERVAL=60
MQTT_STALE_SECONDS=90
OFFLINE_AFTER=300
LOG_LEVEL=INFO

# Weekly statistics (sessions, mowing time), published on <base>/<name>/stats and /session. A week
# starts on Monday 00:00 in this time zone. The numbers are kept in /data/stats.json (a few KB).
TIMEZONE=Europe/Amsterdam
# STATS_FILE=/data/stats.json      (set in the image; empty = statistics off)
# STATS_WEEKS=12
# STATS_MIN_SESSION_S=60

# Log files in /data/logs (volume): events-<date>.jsonl (raw cloud messages and connection/token
# events, for analysis) and navimow2mqtt.log. No tokens or passwords are written. Empty LOG_DIR = off.
# LOG_DIR=/data/logs
# LOG_KEEP_DAYS=14
# LOG_MAX_MB=50

# Language of the sign-in page and the map captions: en (default) or nl. Log lines, MQTT payloads and
# Home Assistant entity names stay English.
# LANGUAGE=en

# Login page (open http://<host>:8099). Set to 0 to turn it off (then use the CLI login).
# WEB_PORT=8099
# The address of that page as seen from your network (the container cannot know it itself).
# Published on <base>/bridge/web_url so openHAB & co. can link to it.
# PUBLIC_URL=http://192.168.1.5:8099

# Advanced (defaults match the official Navimow Home Assistant integration):
# NAVIMOW_REDIRECT_URI=https://my.home-assistant.io/redirect/oauth
# NAVIMOW_TOKEN_FILE=/data/token.json
